{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
